TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ALLOWED_USER_ID=your_numeric_id
GEMINI_API_KEY=your_gemini_key
VAULT_PATH=C:\Users\you\Documents\MyVault
VAULT_NOTES_SUBDIR=reels/
DB_PATH=C:\Users\you\AppData\Local\reel-capture\reels.db
DOWNLOAD_TEMP_DIR=C:\Users\you\AppData\Local\reel-capture\tmp
MAX_VIDEO_DURATION_SECONDS=120
LOG_LEVEL=INFO
# Instagram (and some other sites) reject anonymous downloads. Supply cookies to
# authenticate (both optional). Prefer pulling from an installed browser you are
# logged into...
# YTDLP_COOKIES_FROM_BROWSER=edge
# ...or point to an exported cookies.txt (Netscape format). Ignored if the
# browser option above is set.
# YTDLP_COOKIES_FILE=C:\Users\you\AppData\Local\reel-capture\cookies.txt
